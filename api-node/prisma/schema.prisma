// Database schema (guide 2.3). Prisma creates the PostgreSQL tables from it.
// @map keeps snake_case names in the database while the code uses camelCase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  SHIPPED
  DELIVERED
  CANCELLED
}

// How fast the customer wants the order (chosen in the cart). Express costs more.
enum DeliveryMethod {
  STANDARD // free, 3 to 5 days
  EXPRESS // extra fee, next day
}

// Customer service: what a message to the store is about
enum SupportTopic {
  SIGN_IN // signing in and my account
  ORDER // an order (wrong, missing or damaged item...)
  DELIVERY
  RETURN
  PAYMENT // payments and cards
  CHANGE // change or cancel an order
  OTHER
}

enum SupportStatus {
  OPEN // waiting for the store's answer
  ANSWERED // the store answered: waiting for the customer
  RESOLVED // solved
}

// Who wrote a message in a conversation
enum SupportAuthor {
  CUSTOMER // the customer (or a visitor who is not logged in)
  STAFF // an admin, for the store
}

enum NotificationType {
  LOW_STOCK // stock went down to the reorder level or below
  OUT_OF_STOCK // stock went down to 0
  SUPPORT_MESSAGE // a customer or a visitor wrote to customer service
  // For one customer:
  ORDER_SHIPPED // the store shipped their order
  ORDER_DELIVERED // their order was delivered
  ORDER_CANCELLED // the store cancelled their order
  SUPPORT_ANSWER // customer service answered them
  BACK_IN_STOCK // a sold-out product they waited for is in stock again
}

model User {
  id              Int             @id @default(autoincrement())
  name            String
  email           String          @unique
  passwordHash    String          @map("password_hash")
  role            Role            @default(CUSTOMER)
  // The delivery address saved in My account (customers); the cart fills it in. null = none saved.
  phone           String?
  city            String?
  address         String?
  // When the user typed the 6-digit code from the Register email. null = not verified: can't log in yet.
  emailVerifiedAt DateTime?       @map("email_verified_at")
  // Goes up by 1 when the password changes. A login token remembers the number it was made with,
  // so after a password change every older login (on any device) stops working.
  tokenVersion    Int             @default(0) @map("token_version")
  createdAt       DateTime        @default(now()) @map("created_at")
  emailCode       EmailCode?
  orders          Order[]
  supportTickets  SupportTicket[]
  reviews         Review[]
  favorites       Favorite[]
  stockAlerts     StockAlert[] // sold-out products they want to hear about
  notifications   Notification[] // the customer's bell

  @@map("users")
}

// What an emailed code may be used for. A code only works for its own purpose.
enum CodePurpose {
  VERIFY_EMAIL // sent after Register: "Check your email"
  RESET_PASSWORD // sent from "Forgot password?"
}

// A 6-digit code we emailed. One per user: a new code replaces the old one,
// and it is deleted once it has been used.
model EmailCode {
  userId    Int         @id @map("user_id")
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   CodePurpose @default(VERIFY_EMAIL)
  codeHash  String      @map("code_hash") // stored hashed, like passwords
  expiresAt DateTime    @map("expires_at") // 15 minutes after it was sent
  attempts  Int         @default(0) // wrong tries; after 5 the user needs a new code
  sentAt    DateTime    @default(now()) @map("sent_at") // a new code can be asked for 1 minute later

  @@map("email_codes")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  products  Product[]

  @@map("categories")
}

model Product {
  id            Int            @id @default(autoincrement())
  name          String
  description   String?
  price         Decimal        @db.Decimal(10, 2)
  stock         Int            @default(0)
  reorderLevel  Int            @default(6) @map("reorder_level") // "Low stock" at or below this: 6 = fewer than 7 left
  imageUrl      String?        @map("image_url") // FR-17: path of the uploaded photo, e.g. /uploads/products/product-1-....jpg
  viewCount     Int            @default(0) @map("view_count") // how many times the product page was opened
  reviews       Review[]
  notifications Notification[]
  favorites     Favorite[]
  stockAlerts   StockAlert[] // customers waiting for it to be back in stock
  promotionId   Int?           @map("promotion_id") // the sale this product is in (e.g. Christmas Sale)
  promotion     Promotion?     @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  categoryId    Int            @map("category_id")
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  orderItems    OrderItem[]

  @@index([name])
  @@index([categoryId])
  @@map("products")
}

model Order {
  id             Int             @id @default(autoincrement())
  userId         Int             @map("user_id")
  user           User            @relation(fields: [userId], references: [id])
  status         OrderStatus     @default(PENDING)
  total          Decimal         @db.Decimal(10, 2) // the products + the delivery fee
  delivery       DeliveryMethod  @default(STANDARD)
  deliveryFee    Decimal         @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  deliverBy      DateTime?       @map("deliver_by") // the latest expected arrival day
  // Where to bring the order, typed in the cart. null only for orders from before Nov 11.
  phone          String?
  city           String?
  address        String? // street, building, floor
  // When each step happened, for the tracking timeline (null = not yet, or before Nov 11)
  shippedAt      DateTime?       @map("shipped_at")
  deliveredAt    DateTime?       @map("delivered_at")
  cancelledAt    DateTime?       @map("cancelled_at")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  items          OrderItem[]
  supportTickets SupportTicket[]
  notifications  Notification[] // "shipped", "delivered", "cancelled" in the customer's bell

  @@index([userId])
  @@map("orders")
}

// A customer's rating (1 to 10) and optional comment for a product they bought.
// One review per customer per product; they can change it.
model Review {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([productId, userId])
  @@map("reviews")
}

// Customer service: a conversation between a customer and the store.
// Visitors who are not logged in can write too (e.g. "I can't sign in"): then userId is null
// and the answers go to the email they typed.
model SupportTicket {
  id             Int              @id @default(autoincrement())
  userId         Int?             @map("user_id")
  user           User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String // who wrote: the account's name, or the name a visitor typed
  email          String // where answers are emailed
  topic          SupportTopic
  orderId        Int?             @map("order_id") // the order it is about, if any
  order          Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  status         SupportStatus    @default(OPEN)
  customerUnread Boolean          @default(false) @map("customer_unread") // the store answered and the customer hasn't seen it yet
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at") // the last message (newest conversations first)
  messages       SupportMessage[]
  notifications  Notification[]

  @@index([status])
  @@index([userId])
  @@map("support_tickets")
}

// One message in a customer service conversation.
model SupportMessage {
  id        Int           @id @default(autoincrement())
  ticketId  Int           @map("ticket_id")
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    SupportAuthor
  body      String
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([ticketId])
  @@map("support_messages")
}

// A notification in the bell. Two audiences:
//   userId null: for the admins, shared (when one admin reads it, it is read for all of them).
//     Stock alerts (productId): an order took a product down to its reorder level or to 0.
//     Customer service (ticketId): a customer or a visitor wrote.
//   userId set: for that customer only.
//     Their order (orderId) was shipped, delivered or cancelled by the store.
//     Customer service answered them (ticketId).
// A database rule keeps exactly one of productId, ticketId and orderId.
model Notification {
  id        Int              @id @default(autoincrement())
  type      NotificationType
  message   String
  userId    Int?             @map("user_id") // null = for the admins
  user      User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int?             @map("product_id") // stock alerts
  product   Product?         @relation(fields: [productId], references: [id], onDelete: Cascade)
  ticketId  Int?             @map("ticket_id") // customer service
  ticket    SupportTicket?   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  orderId   Int?             @map("order_id") // a customer's order
  order     Order?           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  readAt    DateTime?        @map("read_at") // null = not read yet
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([readAt])
  @@index([userId])
  @@map("notifications")
}

// A product a customer saved for later (the heart button). One row per customer and product.
model Favorite {
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int      @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, productId])
  @@index([productId])
  @@map("favorites")
}

// "Tell me when it's back": a customer waits for a sold-out product. When it is in stock again,
// they get a notification and an email, and the row is removed. One row per customer and product.
model StockAlert {
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int      @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, productId])
  @@index([productId])
  @@map("stock_alerts")
}

// A sale, e.g. "Christmas Sale": a percentage off some products until a date.
// After the end date the normal prices are back by themselves.
model Promotion {
  id        Int       @id @default(autoincrement())
  name      String
  percent   Int // 1 to 90
  endsAt    DateTime  @map("ends_at")
  createdAt DateTime  @default(now()) @map("created_at")
  products  Product[]

  @@map("promotions")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int     @map("order_id")
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)

  @@map("order_items")
}

// The other currencies the website can show prices in. US dollars are the shop's own currency.
enum Currency {
  LBP // Lebanese pound
  EUR // euro
}

// Exchange rates for showing prices in other currencies. Prices and orders stay in US dollars:
// the website only converts them for display. An admin keeps the rates up to date (Dashboard).
model ExchangeRate {
  currency  Currency @id
  rate      Decimal  @db.Decimal(14, 4) // how much of this currency 1 US dollar is, e.g. 89500 (LBP)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("exchange_rates")
}
