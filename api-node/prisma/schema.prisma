// Database schema (guide 2.3). Prisma creates the PostgreSQL tables from it.
// @map keeps snake_case names in the database while the code uses camelCase.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  SHIPPED
  DELIVERED
  CANCELLED
}

// How fast the customer wants the order (chosen in the cart). Express costs more.
enum DeliveryMethod {
  STANDARD // free, 3 to 5 days
  EXPRESS // extra fee, next day
}

enum IssueType {
  WRONG_ITEM
  DAMAGED
  MISSING_ITEM
  LATE_DELIVERY
  OTHER
}

enum IssueStatus {
  OPEN
  RESOLVED
}

enum NotificationType {
  LOW_STOCK // stock went down to the reorder level or below
  OUT_OF_STOCK // stock went down to 0
}

model User {
  id           Int          @id @default(autoincrement())
  name         String
  email        String       @unique
  passwordHash String       @map("password_hash")
  role         Role         @default(CUSTOMER)
  createdAt    DateTime     @default(now()) @map("created_at")
  orders       Order[]
  issues       OrderIssue[]
  reviews      Review[]
  favorites    Favorite[]

  @@map("users")
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  products  Product[]

  @@map("categories")
}

model Product {
  id            Int            @id @default(autoincrement())
  name          String
  description   String?
  price         Decimal        @db.Decimal(10, 2)
  stock         Int            @default(0)
  reorderLevel  Int            @default(5) @map("reorder_level")
  imageUrl      String?        @map("image_url") // FR-17: path of the uploaded photo, e.g. /uploads/products/product-1-....jpg
  viewCount     Int            @default(0) @map("view_count") // how many times the product page was opened
  reviews       Review[]
  notifications Notification[]
  favorites     Favorite[]
  promotionId   Int?           @map("promotion_id") // the sale this product is in (e.g. Christmas Sale)
  promotion     Promotion?     @relation(fields: [promotionId], references: [id], onDelete: SetNull)
  categoryId    Int            @map("category_id")
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  orderItems    OrderItem[]

  @@index([name])
  @@index([categoryId])
  @@map("products")
}

model Order {
  id          Int            @id @default(autoincrement())
  userId      Int            @map("user_id")
  user        User           @relation(fields: [userId], references: [id])
  status      OrderStatus    @default(PENDING)
  total       Decimal        @db.Decimal(10, 2) // the products + the delivery fee
  delivery    DeliveryMethod @default(STANDARD)
  deliveryFee Decimal        @default(0) @map("delivery_fee") @db.Decimal(10, 2)
  deliverBy   DateTime?      @map("deliver_by") // the latest expected arrival day
  // When each step happened, for the tracking timeline (null = not yet, or before Nov 11)
  shippedAt   DateTime?      @map("shipped_at")
  deliveredAt DateTime?      @map("delivered_at")
  cancelledAt DateTime?      @map("cancelled_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  items       OrderItem[]
  issues      OrderIssue[]

  @@index([userId])
  @@map("orders")
}

// A customer's rating (1 to 10) and optional comment for a product they bought.
// One review per customer per product; they can change it.
model Review {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([productId, userId])
  @@map("reviews")
}

// A problem a customer reports about one of their orders, and the store's answer.
model OrderIssue {
  id         Int         @id @default(autoincrement())
  orderId    Int         @map("order_id")
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId     Int         @map("user_id")
  user       User        @relation(fields: [userId], references: [id])
  type       IssueType
  message    String
  status     IssueStatus @default(OPEN)
  adminReply String?     @map("admin_reply")
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")

  @@index([orderId])
  @@index([status])
  @@map("order_issues")
}

// An automatic alert for the admins, e.g. "Stapler is low on stock: 4 left".
// Created when an order takes a product down to its reorder level or to 0.
// The admins share the alerts: when one admin reads it, it is read for all of them.
model Notification {
  id        Int              @id @default(autoincrement())
  type      NotificationType
  message   String
  productId Int              @map("product_id")
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  readAt    DateTime?        @map("read_at") // null = not read yet
  createdAt DateTime         @default(now()) @map("created_at")

  @@index([readAt])
  @@map("notifications")
}

// A product a customer saved for later (the heart button). One row per customer and product.
model Favorite {
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int      @map("product_id")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, productId])
  @@index([productId])
  @@map("favorites")
}

// A sale, e.g. "Christmas Sale": a percentage off some products until a date.
// After the end date the normal prices are back by themselves.
model Promotion {
  id        Int       @id @default(autoincrement())
  name      String
  percent   Int // 1 to 90
  endsAt    DateTime  @map("ends_at")
  createdAt DateTime  @default(now()) @map("created_at")
  products  Product[]

  @@map("promotions")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int     @map("order_id")
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)

  @@map("order_items")
}
