# Copy this file to .env and change the values if needed.
# .env is not committed (NFR-01: no secrets in the repository).
DATABASE_URL="postgresql://stockflow:stockflow@localhost:5432/stockflow"
JWT_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
CORS_ORIGIN="http://localhost:5173"
PORT=4000

# Emails: the 6-digit code after Register (see "Emails" in the README).
# Empty = nothing is sent; the code is printed in the API window instead.
# SMTP_PASS is a Gmail "app password", never your normal Gmail password.
SMTP_USER=""
SMTP_PASS=""

# The chat assistant: a free AI that runs on this computer with Ollama (https://ollama.com).
# Install Ollama, then download the model once: ollama pull qwen3:4b-instruct
# Without it the shop works; the assistant says it is not available.
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL="qwen3:4b-instruct"
